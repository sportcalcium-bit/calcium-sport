{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calcium-sport/world-event.schema.json",
  "title": "Calcium Sport World Event",
  "type": "object",
  "required": ["id", "occurredAt", "type", "title", "status", "confidence", "entities", "createdBy"],
  "properties": {
    "id": {"type": "string"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "type": {"type": "string", "enum": ["MATCH_CONTEXT", "PERFORMANCE", "QUOTE", "INTERVIEW", "RUMOUR", "OPINION", "SACKING", "APPOINTMENT", "INJURY", "CONTROVERSY", "AWARD", "MEDIA_REACTION", "BOARD_DECISION", "OTHER"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "details": {"type": "string"},
    "status": {"type": "string", "enum": ["CONFIRMED", "RUMOUR", "OPINION"]},
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "lifecycle": {"type": "string", "enum": ["ACTIVE", "DORMANT", "RESOLVED", "CLOSED_FALSE"], "default": "ACTIVE"},
    "source": {"type": "string"},
    "createdBy": {"type": "string", "enum": ["USER", "FACT_API", "ENGINE", "MEDIA"]},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {"type": "string", "enum": ["TEAM", "PLAYER", "MANAGER", "COMPETITION", "MATCH", "STORYLINE"]},
          "name": {"type": "string"},
          "id": {"type": "string"},
          "role": {"type": "string"}
        }
      }
    },
    "storylineIds": {"type": "array", "items": {"type": "string"}},
    "supersedesEventId": {"type": ["string", "null"]},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "CONFIRMED"}}}, "then": {"properties": {"confidence": {"const": 100}}}},
    {"if": {"properties": {"status": {"const": "RUMOUR"}, "lifecycle": {"not": {"const": "CLOSED_FALSE"}}}}, "then": {"properties": {"confidence": {"minimum": 25, "maximum": 75}}}},
    {"if": {"properties": {"status": {"const": "OPINION"}}}, "then": {"properties": {"confidence": {"minimum": 0, "maximum": 25}}}}
  ]
}