{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calcium-sport/storyline.schema.json",
  "title": "Calcium Sport Storyline",
  "type": "object",
  "required": ["id", "title", "status", "importance", "momentum", "entities", "startedAt"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "type": {"type": "string", "enum": ["CLUB_FORM", "MANAGER_PRESSURE", "PLAYER_RISE", "PLAYER_DECLINE", "RIVALRY", "TRANSFER", "AWARD_RACE", "CONTROVERSY", "TITLE_RACE", "RELEGATION", "REDEMPTION", "OTHER"]},
    "status": {"type": "string", "enum": ["ACTIVE", "DORMANT", "RESOLVED"]},
    "importance": {"type": "integer", "minimum": 0, "maximum": 100},
    "momentum": {"type": "integer", "minimum": 0, "maximum": 100},
    "startedAt": {"type": "string", "format": "date-time"},
    "lastUpdatedAt": {"type": "string", "format": "date-time"},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {"type": "string", "enum": ["TEAM", "PLAYER", "MANAGER", "COMPETITION", "MATCH"]},
          "name": {"type": "string"},
          "id": {"type": "string"}
        }
      }
    },
    "eventIds": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "resolution": {"type": ["string", "null"]},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}